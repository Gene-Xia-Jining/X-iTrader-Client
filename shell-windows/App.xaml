<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="XTrader.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              胶囊按钮（品种 / 策略单选）：默认 Button 模板会叠加 PointerOver 等
              主题态画刷，盖掉代码里按 Palette 设的填充色；这里退化成纯 Border +
              ContentPresenter，悬停由页面代码改 Background 实现。
            -->
            <Style x:Key="CapsuleButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              顶栏普通按钮（深浅色 / 刷新 / 退出）：尺寸沿用默认 Button，
              但模板退化成纯 Border + ContentPresenter —— 默认模板的 PointerOver
              会叠加主题灰底，盖掉代码按 Palette 设的悬停色（与侧栏同一个坑）。
              悬停配色在 MainWindow 里按 Palette.SidebarHover/Dim 设置。
            -->
            <Style x:Key="TopBarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <!-- 悬停/按下的颜色由代码设，这里只留状态占位 -->
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              侧栏导航项：Button 退化成纯 Border + 文字，选中/悬停底色与描边由代码
              按 Palette 设置（外观对齐页内分段胶囊，如「快速开始/交易记录」）。
              保留 Button 是为了键盘焦点与 Space/Enter 激活，原生按钮模板会叠
              PointerOver/Pressed 灰底，盖掉主题色。
            -->
            <Style x:Key="SidebarNavItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="MinHeight" Value="36" />
                <!-- 胶囊圆角取按钮高度的一半（36 / 2），与顶栏「自动交易」胶囊一致 -->
                <Setter Property="CornerRadius" Value="18" />
                <!--
                  Auto 列在测量阶段取各子项的 desired width（内边距 + 文字），
                  排布阶段再把 Button 撑满列宽，因此各行胶囊等宽——与 mac 壳
                  侧栏里 maxWidth: .infinity 的效果一致。
                -->
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
