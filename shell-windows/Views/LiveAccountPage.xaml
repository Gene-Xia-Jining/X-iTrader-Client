<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XTrader.Shell.Views.LiveAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="24" Spacing="16">
            <!-- 标题常驻：切到「交易记录」tab 也能看出这是实盘交易页 -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Text="实盘交易" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="Subtitle"
                           Text="添加多个实盘账户，每个账户独立选择期货公司与品种，保存后即时生效。" />
            </StackPanel>

            <!-- 三个 tab：快速开始（账户配置）/ 交易记录（资金、持仓与当日委托）/ 历史成交（成交记录明细），选中态记在 ShellPrefs -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartTab" Content="快速开始" Click="OnStartTabClick"
                        CornerRadius="17" MinHeight="34" Padding="20,0" />
                <Button x:Name="RecordsTab" Content="交易记录" Click="OnRecordsTabClick"
                        CornerRadius="17" MinHeight="34" Padding="20,0" />
                <Button x:Name="TradesTab" Content="历史成交" Click="OnTradesTabClick"
                        CornerRadius="17" MinHeight="34" Padding="20,0" />
                <Button x:Name="TradesHelpButton" Content="?" Click="OnTradesHelpClick"
                        CornerRadius="10" Width="20" Height="20" Padding="0" MinWidth="20" MinHeight="20"
                        VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>

            <!-- 快速开始 tab：账户配置 -->
            <Border x:Name="Card" BorderThickness="1" CornerRadius="18" Padding="20">
                <StackPanel Spacing="12">
                    <Button Content="＋ 添加实盘账户" Click="OnAddClick" HorizontalAlignment="Left" />
                    <TextBlock x:Name="BrokerHint" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <!-- 已保存账户卡在前，新建草稿卡在后 -->
                    <StackPanel x:Name="AccountsPanel" Spacing="10" />
                </StackPanel>
            </Border>

            <!-- 「交易记录」tab：与模拟页同一份实现，只取实盘账户 -->
            <StackPanel x:Name="RecordsPanel" Spacing="16" Visibility="Collapsed" />

            <!-- 「历史成交」tab：与模拟页同一份实现，只取实盘账户 -->
            <StackPanel x:Name="TradesPanel" Spacing="16" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
