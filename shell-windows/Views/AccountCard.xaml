<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XTrader.Shell.Views.AccountCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XTrader.Shell.Views">

    <Border x:Name="Card" BorderThickness="1" CornerRadius="18" Padding="16,14">
        <StackPanel Spacing="10">
            <!-- 标题行：账户名称 + 启用 + 删除 -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LabelBox" PlaceholderText="账户名称（如：光大-主力）" MinHeight="36" />
                <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="启用"
                          VerticalAlignment="Center" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged" />
                <Button x:Name="DeleteButton" Grid.Column="2" Content="删除" Click="OnDeleteClick"
                        Foreground="#E3342F" />
            </Grid>

            <StackPanel x:Name="BrokerRows" Spacing="6" />

            <TextBlock x:Name="TradeAccountLabel" Text="资金账号:" FontSize="13" />
            <TextBox x:Name="TradeAccountBox" PlaceholderText="资金账号 (实盘必填)" MinHeight="36" />
            <TextBlock x:Name="TradePasswordLabel" Text="交易密码:" FontSize="13" />
            <PasswordBox x:Name="TradePasswordBox" PlaceholderText="交易密码 (实盘必填)" MinHeight="36" />
            <TextBlock x:Name="TqAccountLabel" Text="快期账号:" FontSize="13" />
            <TextBox x:Name="TqAccountBox" PlaceholderText="快期账号" MinHeight="36" />
            <TextBlock x:Name="TqPasswordLabel" Text="快期密码:" FontSize="13" />
            <PasswordBox x:Name="TqPasswordBox" PlaceholderText="快期密码" MinHeight="36" />

            <TextBlock x:Name="SymbolLabel" Text="交易品种:" FontSize="13" />
            <StackPanel Spacing="6">
                <views:WrapPanel x:Name="SymbolPanel" Spacing="10" />
                <TextBlock x:Name="SymbolHint" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="StrategyLabel" Text="交易策略:" FontSize="13" />
            <StackPanel Spacing="6">
                <views:WrapPanel x:Name="StrategyPanel" Spacing="10" />
                <TextBlock x:Name="StrategyHint" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <Button Content="保存" Click="OnSaveClick" HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</UserControl>
