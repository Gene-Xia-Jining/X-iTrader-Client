<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XTrader.Shell.Views.SimulationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XTrader.Shell.Views">

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="24" Spacing="16">
            <Border x:Name="Card" BorderThickness="1" CornerRadius="18" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="Intro" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <TextBlock x:Name="Step1" Text="1，下载快期客户端：" TextWrapping="Wrap" />
                    <TextBlock x:Name="LinkMobile" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="LinkAppStore" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="LinkWindows" IsTextSelectionEnabled="True" />

                    <TextBlock x:Name="Step2" Text="2，在快期客户端或天勤官网注册：" TextWrapping="Wrap" />
                    <TextBlock x:Name="LinkRegister" IsTextSelectionEnabled="True" />

                    <TextBlock x:Name="Step3" Text="3，在这里填入：" TextWrapping="Wrap" />

                    <!-- 手机号 / 密码 / 眼睛 / 测试连接（输入完成即保存） -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PhoneLabel" Text="手机号：" VerticalAlignment="Center" />
                        <TextBox x:Name="PhoneBox" Grid.Column="1" PlaceholderText="手机号" MinHeight="36" />
                        <TextBlock x:Name="PasswordLabel" Grid.Column="2" Text="密码："
                                   VerticalAlignment="Center" />

                        <!-- 密码框 + 眼睛按钮合成一组，边框与底色统一画在外层 -->
                        <Border x:Name="PasswordFrame" Grid.Column="3" CornerRadius="8" MinHeight="36"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <!-- 已存密码的自绘掩码（按真实长度），输入框叠在上层 -->
                                    <StackPanel x:Name="PasswordMask" Orientation="Horizontal" Spacing="2.5"
                                                VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False" />
                                    <PasswordBox x:Name="PasswordHidden" BorderThickness="0"
                                                 Background="Transparent" Padding="12,0" MinHeight="34" />
                                    <TextBox x:Name="PasswordShown" BorderThickness="0"
                                             Background="Transparent" Padding="12,0" MinHeight="34"
                                             Visibility="Collapsed" />
                                </Grid>
                                <Button x:Name="EyeButton" Grid.Column="1" Width="40" MinWidth="40"
                                        Padding="0" Click="OnEyeClick"
                                        Background="Transparent" BorderThickness="0" CornerRadius="0" />
                            </Grid>
                        </Border>

                        <Button x:Name="TestButton" Grid.Column="4" Content="测试连接" Click="OnTestClick" />
                    </Grid>
                    <TextBlock x:Name="AccountHint" FontSize="13" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="Step4" Text="4，服务器地址：" VerticalAlignment="Center" />
                        <Button x:Name="ServerHelpButton" Content="?" Click="OnServerHelpClick"
                                Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ServerBox" Width="380" MinHeight="36"
                                 PlaceholderText="https://itrader.redboil.us.ci" />
                        <Button x:Name="ServerTestButton" Content="测试连接" Click="OnTestServerClick" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="Step5" Text="5，Token 管理页面可以申请 Token。"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="TokenHelpButton" Content="?" Click="OnTokenHelpClick"
                                Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                        <Button x:Name="TokenPageButton" Content="前往 Token 管理" Click="OnTokenPageClick"
                                Margin="6,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="Step6" Text="6，选择交易品种：" VerticalAlignment="Center" />
                        <Button x:Name="SymbolHelpButton" Content="?" Click="OnSymbolHelpClick"
                                Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <views:WrapPanel x:Name="SymbolPanel" Spacing="10" />
                        <TextBlock x:Name="SymbolHint" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="Step7" Text="7，选择交易策略：" VerticalAlignment="Center" />
                        <Button x:Name="StrategyHelpButton" Content="?" Click="OnStrategyHelpClick"
                                Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <views:WrapPanel x:Name="StrategyPanel" Spacing="10" />
                        <TextBlock x:Name="StrategyHint" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
