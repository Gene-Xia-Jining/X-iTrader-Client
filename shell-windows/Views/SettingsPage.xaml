<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XTrader.Shell.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="Root" Spacing="16" Padding="24">
            <Border x:Name="Card" BorderThickness="1" CornerRadius="18" Padding="20">
                <StackPanel Spacing="14">

                    <!-- 服务器地址 -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ServerLabel" Text="服务器地址:" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ServerBox" Width="380"
                                     PlaceholderText="https://itrader.redboil.us.ci" />
                            <Button Content="测试连接" Click="OnTestServerClick" />
                        </StackPanel>
                        <TextBlock x:Name="ServerHint"
                                   Text="这是 iTrader 智能交易服务器的地址，需与服务器部署地址一致"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Rectangle Height="1" x:Name="Divider1" />

                    <!-- 代理服务器 -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ProxyLabel" Text="代理服务器:" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="ProxyDirect" Content="直连（默认）" GroupName="proxy" IsChecked="True" />
                            <RadioButton x:Name="ProxySystem" Content="系统代理" GroupName="proxy" />
                            <RadioButton x:Name="ProxyCustom" Content="自定义" GroupName="proxy" />
                        </StackPanel>
                        <TextBox x:Name="ProxyBox" IsEnabled="False"
                                 PlaceholderText="http://127.0.0.1:7890 或 socks5://127.0.0.1:1080" />
                        <TextBlock x:Name="ProxyHint"
                                   Text="仅影响天勤行情/交易连接，iTrader 服务器始终直连；直连会忽略系统代理。socks5 代理需安装 python-socks"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
