<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XTrader.Shell.Views.TradingLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right">
            <Button x:Name="OrderButton" Content="最新在前" Click="OnToggleOrderClick" />
            <Button Content="清空日志" Click="OnClearClick" />
        </StackPanel>

        <!-- 必须是单个 RichTextBlock：每行一个 TextBlock 时选中范围无法跨行。
             选中文本后由 WinUI 自带的选择浮动菜单 / Ctrl+C 复制 -->
        <ScrollViewer x:Name="LogScroll" Grid.Row="1" BorderThickness="1"
                      CornerRadius="11" Padding="12"
                      VerticalScrollBarVisibility="Auto">
            <RichTextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Grid>
</Page>
