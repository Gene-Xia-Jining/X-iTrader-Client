<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XTrader.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="iTrader 智能交易系统">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏：自动交易开关 / 深色浅色 / 刷新 / 退出 -->
        <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <ToggleSwitch x:Name="AutoTradeToggle"
                              OnContent="自动交易"
                              OffContent="自动交易"
                              IsOn="False"
                              MinWidth="0"
                              Toggled="OnAutoTradeToggled" />
                <Button x:Name="ThemeButton" Click="OnThemeToggleClick" Content="深色" />
                <Button x:Name="RefreshButton" Click="OnRefreshClick" Content="刷新" />
                <Button x:Name="QuitButton" Click="OnQuitClick" Content="退出" />
            </StackPanel>
        </Border>

        <!-- 主体：侧边栏 + 页面 -->
        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="240"
                             IsPaneToggleButtonVisible="False"
                             SelectionChanged="OnNavSelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="仪表盘" Tag="dashboard" />
                <muxc:NavigationViewItem Content="Token 管理" Tag="token" />
                <muxc:NavigationViewItem Content="交易日志" Tag="log" />
                <muxc:NavigationViewItem Content="模拟交易" Tag="sim" />
                <muxc:NavigationViewItem Content="实盘交易" Tag="live" />
                <muxc:NavigationViewItem Content="设置" Tag="settings" />
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>

        <!-- 底部状态栏：交易状态 + 服务器连通 + 交易状态点 -->
        <Border x:Name="StatusBar" Grid.Row="2" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="StatusLeft" HorizontalAlignment="Left" Text="交易状态: 已停止" />
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                    <TextBlock x:Name="ServerStatusText" Text="服务器: 未连接" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="TradingDot" Width="10" Height="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="TradingStatusText" Text="已停止" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
