<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XTrader.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iTrader 智能交易系统">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏：版本胶囊 + 服务器状态 / 自动交易开关 / 深色浅色 / 刷新 / 退出。
             上下各一条发丝线：标题栏与顶栏同为白底，只有下边线会连成一片 -->
        <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,1,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- 版本胶囊：平时显示版本号；点击检查更新，发现新版本先确认。
                         下载中胶囊本身随进度从左向右填充，此时点击即取消下载。
                         所以 Padding 放在内层 StackPanel、填充置于最底层 -->
                    <Button x:Name="VersionButton"
                            VerticalAlignment="Center"
                            MinHeight="36"
                            MinWidth="0"
                            Padding="0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Style="{StaticResource VersionPillButtonStyle}"
                            Click="OnVersionClick"
                            PointerEntered="OnVersionPillPointerEntered"
                            PointerExited="OnVersionPillPointerExited"
                            SizeChanged="OnVersionPillSizeChanged">
                        <Grid>
                            <!-- 下载进度：整颗胶囊从左向右填充，百分比靠 ScaleX 表达
                                 （同「自动交易」胶囊的启动进度）。Border 的 CornerRadius
                                 不裁剪子元素，所以套一层同圆角的 Border 做裁剪 -->
                            <Border CornerRadius="18">
                                <!-- 填充压低不透明度，让覆盖其上的版本号/百分比文字保持可读：
                                     版本胶囊的文字随阶段变色（不转白），走满也不转实色。
                                     用 ScaleTransform 而非 Width：本元素在 VersionButton
                                     内部，Width 会参与测量把胶囊撑宽，SizeChanged 又回头
                                     改 Width，与「自动交易」胶囊同源，pct=100 时同样有
                                     布局循环隐患 -->
                                <Rectangle x:Name="VersionProgressFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           RenderTransformOrigin="0,0.5"
                                           Opacity="0.55"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Margin="14,0">
                                <TextBlock x:Name="VersionText" Text="-" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Ellipse x:Name="VersionBadge"
                                         Width="7" Height="7"
                                         VerticalAlignment="Top"
                                         Margin="0,2,0,0"
                                         Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!-- 服务器状态胶囊：整颗可点，弹出服务器信息（地址 / 连通性 / 探测方式） -->
                    <Button x:Name="ServerPill"
                            VerticalAlignment="Center"
                            MinHeight="36"
                            MinWidth="0"
                            Padding="22,0"
                            BorderThickness="1"
                            CornerRadius="18"
                            Background="Transparent"
                            Style="{StaticResource CapsuleButtonStyle}"
                            Click="OnServerInfoClick"
                            PointerEntered="OnServerPillPointerEntered"
                            PointerExited="OnServerPillPointerExited"
                            ToolTipService.ToolTip="点击查看服务器信息">
                        <TextBlock x:Name="ServerStatusText"
                                   Text="服务器：未连接"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <!-- 自动交易胶囊：胶囊底色本身随启动进度从左向右填充，
                         所以 Padding 放在内层 StackPanel、进度条置于最底层 -->
                    <Border x:Name="AutoTradePill"
                            VerticalAlignment="Center"
                            MinHeight="36"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="0"
                            SizeChanged="OnAutoTradePillSizeChanged">
                        <Grid>
                            <!-- Border 的 CornerRadius 不裁剪子元素，填充的右边缘会
                                 露出直角；外面套一层同圆角的 Border 做裁剪 -->
                            <Border CornerRadius="18">
                                <!-- 启动进度：用 ScaleTransform 表达百分比，不能改 Width。
                                     本元素在 AutoTradePill 内部，Width 会参与 Border 的测量，
                                     把胶囊撑宽后 SizeChanged 又回头改 Width，形成布局循环
                                     （Layout cycle detected → 0xC000027B 闪退）。
                                     RenderTransform 不参与布局测量，从根上断掉这条反馈回路。 -->
                                <Rectangle x:Name="AutoTradeProgress"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           RenderTransformOrigin="0,0.5"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Margin="18,0,12,0">
                                <ToggleSwitch x:Name="AutoTradeToggle"
                                              OnContent="自动交易"
                                              OffContent="自动交易"
                                              IsOn="False"
                                              MinWidth="0"
                                              Toggled="OnAutoTradeToggled" />
                                <!-- 问号用 Border + TextBlock：Button 悬停会改浅灰底，破坏胶囊整体观感 -->
                                <Border x:Name="AutoTradeHelpRing" Width="18" Height="18" CornerRadius="9"
                                        BorderThickness="1" VerticalAlignment="Center" Background="Transparent"
                                        Tapped="OnAutoTradeHelpTapped"
                                        PointerEntered="OnAutoTradeHelpPointerEntered"
                                        PointerExited="OnAutoTradeHelpPointerExited">
                                    <TextBlock x:Name="AutoTradeHelpIcon" Text="?" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="ThemeButton" Click="OnThemeToggleClick" Content="深色"
                            Style="{StaticResource TopBarButtonStyle}"
                            PointerEntered="OnTopBarButtonPointerEntered"
                            PointerExited="OnTopBarButtonPointerExited" />
                    <Button x:Name="RefreshButton" Click="OnRefreshClick" Content="刷新"
                            Style="{StaticResource TopBarButtonStyle}"
                            PointerEntered="OnTopBarButtonPointerEntered"
                            PointerExited="OnTopBarButtonPointerExited" />
                    <Button x:Name="QuitButton" Click="OnQuitClick" Content="退出"
                            Style="{StaticResource TopBarButtonStyle}"
                            PointerEntered="OnTopBarButtonPointerEntered"
                            PointerExited="OnTopBarButtonPointerExited" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：侧栏（宽度随导航文字自适应）+ 页面 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏不用 NavigationView：它的面板宽度是固定值，且选中态是系统灰底 -->
            <Border x:Name="Sidebar" Grid.Column="0" BorderThickness="0,0,1,0">
                <!--
                  Auto 列：列宽取最宽标题，各按钮再 stretch 成等宽胶囊。
                  行在 BuildNav 里按路由数量动态添加。
                -->
                <Grid x:Name="NavItems" Margin="14,18" RowSpacing="12" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
