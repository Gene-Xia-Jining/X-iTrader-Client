<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XTrader.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="iTrader 智能交易系统">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏：版本胶囊 + 服务器状态 / 自动交易开关 / 深色浅色 / 刷新 / 退出 -->
        <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- 版本胶囊：平时显示版本号；点击检查更新，发现新版本先确认。
                         下载中胶囊底部显示进度条，此时点击即取消下载 -->
                    <Button x:Name="VersionButton" VerticalAlignment="Center" Click="OnVersionClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="-" VerticalAlignment="Center" />
                                <Ellipse x:Name="VersionBadge"
                                         Width="7" Height="7"
                                         VerticalAlignment="Top"
                                         Margin="0,2,0,0"
                                         Visibility="Collapsed" />
                            </StackPanel>
                            <ProgressBar x:Name="VersionProgress"
                                         Height="3"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,1"
                                         Minimum="0" Maximum="100"
                                         Visibility="Collapsed"
                                         IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                    <Border x:Name="ServerPill"
                            VerticalAlignment="Center"
                            MinHeight="36"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,0,22,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ServerHelpButton" Content="?" Click="OnServerHelpClick"
                                    Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                            <TextBlock x:Name="ServerStatusText"
                                       Text="服务器状态：未连接"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Border x:Name="AutoTradePill"
                            VerticalAlignment="Center"
                            MinHeight="36"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,0,22,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="AutoTradeHelpButton" Content="?" Click="OnAutoTradeHelpClick"
                                    Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                            <ToggleSwitch x:Name="AutoTradeToggle"
                                          OnContent="自动交易"
                                          OffContent="自动交易"
                                          IsOn="False"
                                          MinWidth="0"
                                          Toggled="OnAutoTradeToggled" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Click="OnThemeToggleClick" Content="深色" />
                    <Button x:Name="RefreshButton" Click="OnRefreshClick" Content="刷新" />
                    <Button x:Name="QuitButton" Click="OnQuitClick" Content="退出" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：侧栏（宽度随导航文字自适应）+ 页面 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏不用 NavigationView：它的面板宽度是固定值，且选中态是系统灰底 -->
            <Border x:Name="Sidebar" Grid.Column="0" BorderThickness="0,0,1,0">
                <!--
                  Auto 列：列宽取最宽标题，各按钮再 stretch 成等宽胶囊。
                  行在 BuildNav 里按路由数量动态添加。
                -->
                <Grid x:Name="NavItems" Margin="14,18" RowSpacing="6" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
