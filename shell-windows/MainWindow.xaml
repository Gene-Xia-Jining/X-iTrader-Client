<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XTrader.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="iTrader 智能交易系统">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏：服务器状态 + 自动交易开关 / 深色浅色 / 刷新 / 退出 -->
        <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Border x:Name="ServerPill"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MinHeight="36"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,0,22,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ServerHelpButton" Content="?" Click="OnServerHelpClick"
                                Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                        <TextBlock x:Name="ServerStatusText"
                                   Text="服务器状态：未连接"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Border x:Name="AutoTradePill"
                            VerticalAlignment="Center"
                            MinHeight="36"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,0,22,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="AutoTradeHelpButton" Content="?" Click="OnAutoTradeHelpClick"
                                    Width="20" Height="20" MinWidth="20" Padding="0" CornerRadius="10" FontSize="12" />
                            <ToggleSwitch x:Name="AutoTradeToggle"
                                          OnContent="自动交易"
                                          OffContent="自动交易"
                                          IsOn="False"
                                          MinWidth="0"
                                          Toggled="OnAutoTradeToggled" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Click="OnThemeToggleClick" Content="深色" />
                    <Button x:Name="RefreshButton" Click="OnRefreshClick" Content="刷新" />
                    <Button x:Name="QuitButton" Click="OnQuitClick" Content="退出" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：侧边栏 + 页面 -->
        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="240"
                             IsPaneToggleButtonVisible="False"
                             SelectionChanged="OnNavSelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="仪表盘" Tag="dashboard" />
                <muxc:NavigationViewItem Content="Token 管理" Tag="token" />
                <muxc:NavigationViewItem Content="交易日志" Tag="log" />
                <muxc:NavigationViewItem Content="模拟交易" Tag="sim" />
                <muxc:NavigationViewItem Content="实盘交易" Tag="live" />
                <muxc:NavigationViewItem Content="交易记录" Tag="records" />
                <muxc:NavigationViewItem Content="设置" Tag="settings" />
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
